# Copy to server/.env for local development. Set the same keys in Render → Environment.

# MongoDB connection string (read in models/init.js)
DATABASE_URL=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/pitchers?retryWrites=true&w=majority

# Signs player (team) login tokens
JWT_SECRET=

# Admin console (/admin). All three are required or admin login returns 503.
ADMIN_USERNAME=
# Generate with: npm run hash-admin-password   (never put the plain password here)
ADMIN_PASSWORD_HASH=
# Must be different from JWT_SECRET
ADMIN_JWT_SECRET=

# Optional. "true" re-enables POST /api/auth/register; anything else keeps it disabled
ALLOW_PUBLIC_REGISTRATION=false

# Optional. Comma-separated allowed browser origins; empty allows any origin
CORS_ORIGINS=
